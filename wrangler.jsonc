{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neghashi-o-hads",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "CONFIG", "class_name": "Config" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker"] },
    { "tag": "v2", "new_sqlite_classes": ["Config"] }
  ]
}
